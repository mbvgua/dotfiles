#!/usr/bin/env bash

set -eo pipefail

output_dir="$HOME/Pictures/Screenshots/"
timestamp=$(date +"%Y-%m-%d_%I-%M")
choice="$1"


usage() {
    echo " Usage:
        This script takes a system screesnhot using flameshot
        A notification is also sent using dunstc, showing if the screenshot
        was successful or not,

        To run it:
        $ $0 [selection] [fullscreen] [all]
        "
}

#ensure only 1 arg passed
if [[ "$#" -ne 1 ]]; then
    usage
    exit 1
else
    case "$choice" in
        selection)
            # screenshot of only select region
            flameshot gui --path "$output_dir" --clipboard
            ;;
        fullscreen)
            # takes full screenshot of where cursor is
            # HACK: -n 0 is a hack
            flameshot screen --number 0 --delay 500 --path "$output_dir" --clipboard
            ;;
        all)
            # takes screenshot of all screens
            flameshot full --delay 500 --path "$output_dir" --clipboard
        ;;
        *)
            usage
            exit 1
        ;;
    esac
fi
