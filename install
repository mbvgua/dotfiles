#!/usr/bin/env bash

set -eou pipefail

# --- VARIABLES --- #
LANG_PACKAGES=(
    perl lua python luajit make gcc clang nodejs git git-lfs stow pipx
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
)

USERLAND_PACKAGES=(
    qtile xfce4 bash btop alacritty flameshot vim nvim tmux
    qbittorrent gparted wget curl xclip mariadb ripgrep
    picom rofi dunst feh mpv brightnessctl redshift btop
    ImageMagick unzip autoconf automake xset xrandr ffmpeg-free
    zathura zathura-pdf-poppler zathura-pdf-mupdf zathura-ps zathura-ps zathura-cb zathura-djvu
)
TEMP_DIR=$(mktemp -d)

# --- FUNCTIONS --- #
usage() {
    echo "
    Install system confiuration files and programs instantly.

    Usage: $ $0 [OPTIONS]

    A list of options is listed below:

    -s, --setup             install system packages and configurations
    -d, --dots              clone dotfiles and set them up
    -h, ---help             print this help segment and exit
    "
}

# remove temp_dir created in a particular section
cleanup() {
    rm -rf "$TEMP_DIR"
}
# when script exits, remove the temp dir created
trap cleanup EXIT

install_fonts() {
    local fonts_dir="$HOME/.local/share/fonts"
    if [[ ! -d "$fonts_dir" ]]; then 
        mkdir -p "$fonts_dir"
    fi

    cd $TEMP_DIR
    wget https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraMono.zip
    wget https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip

    unzip FiraMono.zip -d "$fonts_dir"
    unzip JetBrainsMono.zip -d "$fonts_dir"
    fc-cache -fv
}

setup_dots() {
    local DOTS_DIR="~/.dotfiles"
    local DOTS_BACKUP="~/.dotfiles.backup"
    local TARGET_BRANCH="fedora"

    git clone ssh://git@github.com/mbvgua/dotfiles.git "$DOTS_DIR"
    cd "$DOTS_DIR"

    # pull all remote branches locally
    git !git branch -r | \
        grep -v "\->" | \
        while read remote; do \
            git branch --track "${remote#origin/}" "$remote"; \
        done && \
        git fetch --all && \
        git pull --all

    git checkout "$TARGET_BRANCH"
    stow .
}

install_from_source() {
    cd $TEMP_DIR

    # keyd
    git clone https://github.com/rvaiya/keyd
    cd keyd
    make && sudo make install
    sudo systemctl enable --now keyd

    # sublime-merge
    # cmus
}

# --- IMPLEMENTATION --- #
if [[ "$#" -eq 1 ]]; then 

    OPERATION="$1"

    case $OPERATION in
        "--setup" | "-s" )
            echo "1.) installing base packages..."
            sudo dnf install "${LANG_PACKAGES[@]}" "${USERLAND_PACKAGES[@]}" --skip-unavailable

            echo "2.) installing system fonts..."
            install_fonts

            # touchpad click support
            echo "3.) adding touchpad click support..."
            sudo cp ./40-libinput-touchpad.conf /etc/X11/xorg.conf.d/

            # remapping keyboard keys with keyd
            echo "4.) remapping keyboard layout..."
            sudo cp ./default.conf /etc/keyd/

            # install misc packages
            echo "5.) Misc setup..."
            sudo pnpm install -g typescript sass
            pipx install git-filter-repo yt-dlp fastapi
            ;;
        "--dots" | "-d")
            echo "Configuring dotfiles..."
            if [[ ! -d "$DOTS_DIR" ]]; then
                echo "seting up your dotfiles..."
                setup_dots
            else
                echo "$DOTS_DIR directory found, safely moving it to $DOTS_BACKUP"
                mv -r "$DOTS_DIR" "$DOTS_BACKUP"
                echo "seting up your dotfiles..."
                setup_dots
            fi
            ;;
        "--help" | "-h")
            usage
            exit 1
            ;;
        *)
            echo "Unkown option $OPERATION"
            echo "Use --help for usage information"
            exit 1
    esac
elif [[ "$#" -eq 0 ]]; then
    echo "No arguments passed"
    usage
    exit 2
else
    echo "Too many arguments passed"
    usage
    exit 2
fi

