{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/deepseek-v4.1-flash-free",
    "permissions": [
        {
            "action": "read",
            "resource": "*.secrets",
            "effect": "deny"
        }
    ],
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 10000
        },
        "buffer": 20000
    }
}
